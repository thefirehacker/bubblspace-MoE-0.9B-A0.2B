# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/*
venv/
env/

# Secrets / local config
.env

# W&B
wandb/

# Training artifacts (live on mounted persistent storage, not in git).
# Rooted (leading /) so these never shadow source subpackages of the same
# name, e.g. src/data/ — a bare "data/" matches at any depth and once
# silently excluded the entire src/data/ package from every commit.
/checkpoints/
/data/
*.pt
*.ckpt
*.idx
shard_*.bin

# OS / editor
.DS_Store
.vscode/
.idea/
